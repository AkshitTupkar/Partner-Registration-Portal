# Copy to .env and adjust.
PORT=4000
DATABASE_URL="file:./dev.db"

# Comma-separated origins allowed to call the API (not needed in dev: Vite proxies /api).
CORS_ORIGIN=http://localhost:5173

# OTP (FR-20 / INT-07). "mock" sends nothing and always uses MOCK_OTP_CODE.
# The API refuses to start with "mock" when NODE_ENV=production.
OTP_PROVIDER=mock
MOCK_OTP_CODE=1234
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Serves /api/internal/leads (lead list and detail) for the CRM to build against.
# It has no authentication, so the API refuses to start with it on in production.
INTERNAL_API_ENABLED=true

# Used to hash OTP codes at rest. Set a long random value outside dev.
OTP_HASH_SECRET=dev-only-change-me
